# Copy to .env.local (never commit it) and fill in. Every variable is optional
# for the public site: with none set it builds and runs from src/content/*.json,
# form submissions are only logged, and /admin shows a setup notice.

# --- App ---------------------------------------------------------------------
# Absolute origin used in emailed links (invites, password resets, submission
# alerts). Defaults to https://goodwillstaffing.ca in production and
# http://localhost:3000 in development. Set it on preview deployments.
APP_URL=

# --- Neon Postgres --------------------------------------------------------------
# Pooled connection string (host contains "-pooler"), used by the app.
DATABASE_URL=
# Direct connection string, used by `npm run db:migrate` and the scripts.
DATABASE_URL_UNPOOLED=
# Key for hashing visitor IPs (rate limits, submission meta). Required in
# production once DATABASE_URL is set. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=

# --- AWS (one IAM user can cover S3 and SES) ----------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# S3: public site media under media/, private form uploads under private/.
S3_BUCKET=
S3_REGION=ca-central-1
# Public base URL of the bucket (or a CloudFront domain in front of it), no
# trailing slash. Defaults to https://<bucket>.s3.<region>.amazonaws.com
S3_PUBLIC_URL=
# Where the site loads "/media/..." content from: S3_PUBLIC_URL + "/media".
# Leave empty locally to serve public/media. Baked in at build time.
NEXT_PUBLIC_MEDIA_URL=

# SES: verified sender identity, e.g. "Goodwill Staffing <no-reply@goodwillstaffing.ca>".
MAIL_FROM=
# Defaults to S3_REGION when empty.
SES_REGION=

# --- Form notifications ----------------------------------------------------------
# Comma-separated recipients per form group (see "notify" in src/forms/definitions).
# Groups without their own list fall back to FORM_NOTIFY_DEFAULT.
FORM_NOTIFY_DEFAULT=
FORM_NOTIFY_STAFFING=
FORM_NOTIFY_RECRUITMENT=
FORM_NOTIFY_CAREERS=
FORM_NOTIFY_GENERAL=
FORM_NOTIFY_MARKETING=
FORM_NOTIFY_HOUSING=
FORM_NOTIFY_NEWSLETTER=
# SmartApply (GoodwillBot chat at /ai-recruiter/). The live site sent these to
# info@goodwillstaffing.ca,harini@goodwillstaffing.ca,careers@goodwillstaffing.ca
# with the subject "Notification: New Smart Apply Submission" (set in the form
# definition; the sender is MAIL_FROM).
FORM_NOTIFY_SMARTAPPLY=

# --- Salesforce -------------------------------------------------------------------
# Set to 1 to forward the nurse-lead form to Salesforce Web-to-Lead.
SALESFORCE_FORWARD=
